e61142ab.jpg"],"imageAlts":["Hai cổ động viên nam và nữ đứng bật dậy trên khán đài, giơ tay reo hò khi xem trận bóng đá hấp dẫn."],"needsReview":false},{"id":"xh30-4-05-q069","number":69,"type":"writing_sentence","instruction":null,"prompt":"礼貌","options":[],"images":["assets/q069.098ec87d4658.jpg"],"imageAlts":["Trong hành lang chung cư, một cậu bé đeo cặp lễ phép cúi đầu vẫy tay chào bà hàng xóm vừa bước ra cửa, bà mỉm cười."],"needsReview":false},{"id":"xh30-4-05-q070","number":70,"type":"writing_essay","instruction":"第二部分\n第 70 题：写短文。","prompt":"请写一篇不少于 80 字的短文，谈谈父母教会你的一件小事。","options":[],"images":[],"needsReview":false}]}],"examples":[],"questionCount":70,"hasAudio":true,"audioUrl":"https://static.xiehanzi.com/hsk-audio/xh30-4-05/full.dd8d385b665d.mp3","images":[{"path":"assets/q065.cef3b32f9cfa.jpg","src":"https://static.xiehanzi.com/hsk-tests/xh30-4-05/assets/q065.cef3b32f9cfa.jpg"},{"path":"assets/q066.827113868771.jpg","src":"https://static.xiehanzi.com/hsk-tests/xh30-4-05/assets/q066.827113868771.jpg"},{"path":"assets/q067.cb44d044709c.jpg","src":"https://static.xiehanzi.com/hsk-tests/xh30-4-05/assets/q067.cb44d044709c.jpg"},{"path":"assets/q068.d9c2e61142ab.jpg","src":"https://static.xiehanzi.com/hsk-tests/xh30-4-05/assets/q068.d9c2e61142ab.jpg"},{"path":"assets/q069.098ec87d4658.jpg","src":"https://static.xiehanzi.com/hsk-tests/xh30-4-05/assets/q069.098ec87d4658.jpg"}]}