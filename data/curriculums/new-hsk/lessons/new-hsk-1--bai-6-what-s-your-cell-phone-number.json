":"New HSK 1"}},{"_id":"6a2d19e4a9baeea06b4ae98e","hanzi":"坐","pinyin":"zuò","traditional":"坐","traditionalPinyin":"zuò","audios":["https://static.xiehanzi.com/word_audios/坐.mp3"],"translationVi":"ngồi","chars":["坐"],"collocations":[{"hanzi":"坐下","pinyin":"zuò xià","vietnamese":"ngồi xuống"},{"hanzi":"坐车","pinyin":"zuò chē","vietnamese":"đi xe"},{"hanzi":"请坐","pinyin":"qǐng zuò","vietnamese":"mời ngồi"},{"hanzi":"坐着","pinyin":"zuò zhe","vietnamese":"ngồi (trạng thái)"}],"enrichmentDate":"2026-05-26T19:14:41.090638+00:00","enrichmentVersion":"word-v2","examples":[{"hanzi":"请坐","pinyin":"Qǐng zuò","vietnamese":"Mời ngồi"},{"hanzi":"我坐在这里","pinyin":"Wǒ zuò zài zhèlǐ","vietnamese":"Tôi ngồi ở đây"},{"hanzi":"坐下","pinyin":"zuò xià","vietnamese":"ngồi xuống"},{"hanzi":"坐着","pinyin":"zuò zhe","vietnamese":"đang ngồi"},{"hanzi":"坐车","pinyin":"zuò chē","vietnamese":"đi xe, ngồi trên xe"},{"hanzi":"我坐这儿，你坐那儿。","pinyin":"Wǒ zuò zhèr, nǐ zuò nàr.","vietnamese":"Mình ngồi đây, bạn ngồi đằng kia nhé.","source":"path-content","promotedBatch":"release-v1-261028-content"}],"usageNote":"Động từ chỉ hành động ngồi. Trong giao tiếp, 请坐 (mời ngồi) là lời mời lịch sự. 坐下 (ngồi xuống) diễn tả hành động chuyển từ đứng sang ngồi. 坐车 (ngồi trên xe) nghĩa là đi tàu xe. Trong tiếng Trung, 坐 cũng dùng cho việc đi tàu xe (không phải lái).","wordMeaningVi":"ngồi","wordType":"single-char-used-as-word","curriculum":"New HSK","curriculumSlug":"new-hsk","level":"New HSK 1","levelSlug":"new-hsk-1","importSource":"newhsk1-gap-260613","topic":"Động từ thường lệ","topicSlug":"dong-tu-thuong-le","hanviet":"toạ","hanvietGloss":"ngồi, chỗ ngồi, đi xe","wordClassNote":"Thường làm động từ chỉ tư thế ngồi hoặc hành động đi các phương tiện giao thông công cộng.","wordClassSource":"character","wordClasses":["verb","noun"],"searchPriority":1,"viFolded":"ngoi ; ngoi ; toa","components":[],"pinyinRaw":"zuò","wordPinyin":"zuò","listLevel":{"slug":"new-hsk-1","name":"New HSK 1"}},{"legacyIds":{"level":"3225","topic":