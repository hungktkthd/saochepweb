{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/media/visuals/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-visuals/:path*"
    },
    {
      "source": "/media/etymology/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-etymology/:path*"
    },
    {
      "source": "/media/audios/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-audios/:path*"
    },
    {
      "source": "/media/hsk-audio/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-hsk-audio/:path*"
    },
    {
      "source": "/media/sentences-1/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-sentences-1/:path*"
    },
    {
      "source": "/media/sentences-2/:path*",
      "destination": "https://raw.githubusercontent.com/hungktkthd/saochepweb/media-sentences-2/:path*"
    },
    {
      "source": "/han-tu/:slug*",
      "destination": "/han-tu.html"
    },
    {
      "source": "/tu-vung/:slug*",
      "destination": "/tu-vung.html"
    },
    {
      "source": "/han-viet/:slug*",
      "destination": "/han-viet.html"
    },
    {
      "source": "/ngu-phap/:slug*",
      "destination": "/ngu-phap.html"
    },
    {
      "source": "/luyen-chep-chinh-ta/:slug*",
      "destination": "/luyen-chep-chinh-ta.html"
    },
    {
      "source": "/thu-vien-hsk/:level/:slug+",
      "destination": "/thu-vien-hsk/:level.html"
    },
    {
      "source": "/thu-vien-new-hsk/:level/:slug+",
      "destination": "/thu-vien-new-hsk/:level.html"
    },
    {
      "source": "/thu-vien-yct/:level/:slug+",
      "destination": "/thu-vien-yct/:level.html"
    },
    {
      "source": "/thu-vien-boya/:level/:slug+",
      "destination": "/thu-vien-boya/:level.html"
    },
    {
      "source": "/thu-vien-hanyu-jiaocheng/:level/:slug+",
      "destination": "/thu-vien-hanyu-jiaocheng/:level.html"
    },
    {
      "source": "/kiem-tra-hsk/:slug*",
      "destination": "/kiem-tra-hsk.html"
    },
    {
      "source": "/kiem-tra-yct/:slug*",
      "destination": "/kiem-tra-hsk.html"
    },
    {
      "source": "/de-kiem-tra/:slug*",
      "destination": "/de-kiem-tra.html"
    },
    {
      "source": "/so-tay/:slug*",
      "destination": "/so-tay.html"
    },
    {
      "source": "/hoc/:slug*",
      "destination": "/hoc.html"
    },
    {
      "source": "/tro-choi/:slug*",
      "destination": "/tro-choi.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
