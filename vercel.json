{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/xiehanzi-runtime.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(site|manifest)\\.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(images|sounds)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/images/studio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/_next/static/media/:font*.woff2", "destination": "/_next/static/media/00f4982f357db61e-s.p.woff2" },
    { "source": "/monitoring", "destination": "/api/ai" },
    { "source": "/thay-do-rt/:path*", "destination": "/api/ai" },
    { "source": "/assets/public/favicon.svg", "destination": "/favicon.ico" },
    { "source": "/han-tu/:slug+", "destination": "/han-tu" },
    { "source": "/tu-vung/:slug+", "destination": "/tu-vung" },
    { "source": "/han-viet/:slug+", "destination": "/han-viet" },
    { "source": "/ngu-phap/:level/:pointId+", "destination": "/ngu-phap" },
    { "source": "/ngu-phap/:slug+", "destination": "/ngu-phap" },
    { "source": "/luyen-chep-chinh-ta/:id+", "destination": "/luyen-chep-chinh-ta" },
    { "source": "/thu-vien-hsk/:path+", "destination": "/thu-vien-hsk" },
    { "source": "/thu-vien-new-hsk/:path+", "destination": "/thu-vien-new-hsk" },
    { "source": "/thu-vien-boya/:path+", "destination": "/thu-vien-boya" },
    { "source": "/thu-vien-hanyu-jiaocheng/:path+", "destination": "/thu-vien-hanyu-jiaocheng" },
    { "source": "/thu-vien-yct/:path+", "destination": "/thu-vien-yct" },
    { "source": "/thu-vien-tu-vung", "destination": "/thu-vien-new-hsk" },
    { "source": "/thu-vien-tu-vung/:path*", "destination": "/thu-vien-new-hsk" },
    { "source": "/thu-vien-chu-han", "destination": "/thu-vien-hsk" },
    { "source": "/thu-vien-chu-han/:path*", "destination": "/thu-vien-hsk" },
    { "source": "/thu-vien-boyahsk", "destination": "/thu-vien-boya" },
    { "source": "/thu-vien-boyahsk/:path*", "destination": "/thu-vien-boya" },
    { "source": "/thu-vien-msutong", "destination": "/thu-vien-boya" },
    { "source": "/thu-vien-msutong/:path*", "destination": "/thu-vien-boya" },
    { "source": "/thu-vien-giao-trinh-han-ngu", "destination": "/thu-vien-hanyu-jiaocheng" },
    { "source": "/thu-vien-giao-trinh-han-ngu/:path*", "destination": "/thu-vien-hanyu-jiaocheng" },
    { "source": "/thu-vien/:path+", "destination": "/thu-vien" },
    { "source": "/kiem-tra-hsk/:path+", "destination": "/kiem-tra-hsk" },
    { "source": "/kiem-tra-yct", "destination": "/kiem-tra-hsk" },
    { "source": "/kiem-tra-yct/:path*", "destination": "/kiem-tra-hsk" },
    { "source": "/de-kiem-tra/lam-bai/:id*", "destination": "/de-kiem-tra" },
