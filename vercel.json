    { "source": "/thu-vien-giao-trinh-han-ngu/:path*", "destination": "/thu-vien-giao-trinh-han-ngu" },
    { "source": "/thu-vien-hanyu-jiaocheng/:path*", "destination": "/thu-vien-hanyu-jiaocheng" },
    { "source": "/thu-vien-yct/:path*", "destination": "/thu-vien-yct" },
