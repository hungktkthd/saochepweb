{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/_next/static/media/:font*.woff2", "destination": "/_next/static/media/00f4982f357db61e-s.p.woff2" },
    { "source": "/monitoring", "destination": "/api/ai" },
    { "source": "/thay-do-rt/:path*", "destination": "/api/ai" },
    { "source": "/assets/public/favicon.svg", "destination": "/favicon.ico" },
    { "source": "/han-tu/:slug+", "destination": "/han-tu" },
    { "source": "/tu-vung/:slug+", "destination": "/tu-vung" },
    { "source": "/han-viet/:slug+", "destination": "/han-viet" },
    { "source": "/ngu-phap/:level/:pointId+", "destination": "/ngu-phap" },
    { "source": "/ngu-phap/:slug+", "destination": "/ngu-phap" },
    { "source": "/luyen-chep-chinh-ta/:id+", "destination": "/luyen-chep-chinh-ta" },
    { "source": "/thu-vien-hsk/:level/:subpath+", "destination": "/thu-vien-hsk/:level" },
    { "source": "/thu-vien-new-hsk/:level/:subpath+", "destination": "/thu-vien-new-hsk/:level" },
    { "source": "/thu-vien-boya/:level/:subpath+", "destination": "/thu-vien-boya/:level" },
    { "source": "/thu-vien-hanyu-jiaocheng/:level/:subpath+", "destination": "/thu-vien-hanyu-jiaocheng/:level" },
    { "source": "/thu-vien-yct/:level/:subpath+", "destination": "/thu-vien-yct/:level" },
    { "source": "/thu-vien-tu-vung", "destination": "/thu-vien-new-hsk" },
    { "source": "/thu-vien-tu-vung/:path*", "destination": "/thu-vien-new-hsk" },
    { "source": "/thu-vien-chu-han", "destination": "/thu-vien-hsk" },
    { "source": "/thu-vien-chu-han/:path*", "destination": "/thu-vien-hsk" },
