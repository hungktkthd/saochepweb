    { "source": "/luyen-nghe/:path+", "destination": "/luyen-nghe" },
    { "source": "/luyen-noi/:path+", "destination": "/luyen-noi" },
    { "source": "/luyen-go/:path+", "destination": "/luyen-go" },
    { "source": "/luyen-go-han-tu/:path+", "destination": "/luyen-go-han-tu" },
    { "source": "/luyen-viet/:path+", "destination": "/luyen-viet" },
    { "source": "/so-tay/:path+", "destination": "/so-tay" },
    { "source": "/tro-choi/:path+", "destination": "/tro-choi" },
    { "source": "/thay-do/:path+", "destination": "/thay-do" },
    { "source": "/truong-thay-do/:path+", "destination": "/truong-thay-do" },
    { "source": "/hoc/bat-dau", "destination": "/bat-dau" },
    { "source": "/hoc/bat-dau/:path+", "destination": "/bat-dau" },
    { "source": "/hoc/chang/:id*", "destination": "/hoc" },
    { "source": "/hoc/bai/:id*", "destination": "/hoc" },
    { "source": "/hoc/kiem-tra-cap/:id*", "destination": "/hoc" },
    { "source": "/hoc/tien-do", "destination": "/hoc" },
    { "source": "/hoc/tien-do/:path*", "destination": "/hoc" },
    { "source": "/hoc/thoi-quen", "destination": "/hoc" },
    { "source": "/hoc/thoi-quen/:path*", "destination": "/hoc" },
    { "source": "/hoc/hom-nay", "destination": "/hoc" },
    { "source": "/hoc/noi", "destination": "/hoc" },
    { "source": "/hoc/:path+", "destination": "/hoc" },
    { "source": "/tra-chu/bo-thu/:radical+", "destination": "/tra-chu" },
    { "source": "/tra-chu/hsk/:level+", "destination": "/tra-chu/hsk/1" },
    { "source": "/on-tap/:path+", "destination": "/on-tap" },
    { "source": "/bat-dau/:path+", "destination": "/bat-dau" },
    { "source": "/bo-suu-tap", "destination": "/thu-vien" },
    { "source": "/bo-suu-tap/:path*", "destination": "/thu-vien" },
    { "source": "/lo-trinh", "destination": "/hoc" },
    { "source": "/lo-trinh/:path*", "destination": "/hoc" },
    { "source": "/lo-trinh-cua-toi", "destination": "/hoc" },
    { "source": "/lo-trinh-cua-toi/:path*", "destination": "/hoc" },
    { "source": "/tai-app", "destination": "/index" },
    { "source": "/cac-goi", "destination": "/index" },
    { "source": "/quen-mat-khau", "destination": "/dang-nhap" },
    { "source": "/dat-lai-mat-khau", "destination": "/dang-nhap" }
  ]
}
